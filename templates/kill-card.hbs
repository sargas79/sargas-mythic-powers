<div class="smp-card smp-auto-card smp-auto-kill">
  <div class="smp-whisper">{{whisper}}</div>
  <h3>{{title}}</h3>
  <p>{{{body}}}</p>
  <p>{{{killerLine}}} {{{othersLine}}}</p>
  {{#if pending}}
    <div class="smp-buttons">
      <button type="button" class="smp-auto-primary" data-smp-action="award">{{labels.award}}</button>
      <button type="button" data-smp-action="change">{{labels.change}}</button>
      <button type="button" data-smp-action="ignore">{{labels.ignore}}</button>
    </div>
  {{else}}
    <p class="smp-auto-status smp-auto-{{status}}">{{statusText}}</p>
  {{/if}}
</div>
