<div class="smp-card smp-auto-card smp-auto-death">
  <div class="smp-whisper">{{whisper}}</div>
  <h3>{{title}}</h3>
  <p>{{{body}}}</p>
  <p class="smp-auto-doomed"><b>{{doomedLine}}</b> {{diesAt}}</p>
  {{#if canUndo}}
    <div class="smp-buttons">
      <button type="button" data-smp-action="undo">{{labels.undo}}</button>
    </div>
  {{/if}}
  {{#if undone}}<p class="smp-auto-status smp-auto-undone">{{undoneText}}</p>{{/if}}
</div>
