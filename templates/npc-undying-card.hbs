<div class="smp-card smp-auto-card smp-npc-card smp-npc-undying">
  <div class="smp-whisper">{{whisper}}</div>
  <h3>{{title}}</h3>
  <p>{{{body}}}</p>
  {{#if pending}}
    <div class="smp-buttons">
      <button type="button" class="smp-auto-primary" data-smp-action="use">{{labels.use}}</button>
      <button type="button" data-smp-action="fall">{{labels.fall}}</button>
    </div>
  {{else}}
    <p class="smp-auto-status smp-npc-{{status}}">{{statusText}}</p>
  {{/if}}
</div>
