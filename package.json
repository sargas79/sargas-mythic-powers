{
  "name": "sargas-mythic-powers",
  "version": "0.2.0",
  "private": true,
  "description": "Per-character mythic power for the Pathfinder Second Edition system on Foundry VTT",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "assets": "node scripts/merge-assets.mjs",
    "build": "npm run assets && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "link": "node scripts/link-foundry.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
